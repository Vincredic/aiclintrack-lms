VITE_CTMS_ORIGIN=https://app.yourdomain.com
# Static-site catalog editor gate. Required in production for #admin.
# This value is inlined at build time — it is not a server login.
VITE_ADMIN_KEY=
# CTMS progress API (no trailing slash), e.g. https://app.yourdomain.com/api/lms
# Requires a launch token on the iframe URL: ?token=…
# Leave empty to keep progress on this device only.
VITE_PROGRESS_API_URL=
